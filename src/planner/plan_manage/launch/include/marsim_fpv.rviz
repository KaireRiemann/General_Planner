          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Alpha: 0.800000011920929
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 2.6500000953674316
            Min Value: 0.15000000596046448
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
