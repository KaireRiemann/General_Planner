<launch>
    <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>
    <arg name="map_size_z_"/>
    <arg name="odometry_topic"/>
    <arg name="camera_pose_topic"/>
    <arg name="depth_topic"/>
    <arg name="cloud_topic"/>
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <arg name="max_vel"/>
    <arg name="max_acc"/>
    <arg name="max_jer"/>
    <arg name="planning_horizon"/>
    <arg name="point_num"/>
    <arg name="point0_x"/>
    <arg name="point0_y"/>
    <arg name="point0_z"/>
    <arg name="point1_x"/>
    <arg name="point1_y"/>
    <arg name="point1_z"/>
    <arg name="point2_x"/>
    <arg name="point2_y"/>
    <arg name="point2_z"/>
    <arg name="point3_x"/>
    <arg name="point3_y"/>
    <arg name="point3_z"/>
    <arg name="point4_x"/>
    <arg name="point4_y"/>
    <arg name="point4_z"/>
    <arg name="flight_type"/>
    <arg name="use_multitopology_trajs"/>
    <arg name="use_sfc_corridor" default="false"/>
    <arg name="use_esdf" default="false"/>
    <arg name="use_tracking_task" default="false"/>
    <arg name="tracking_reference_topic" default="/tracking/reference"/>
    <arg name="tracking_relay_goal" default="true"/>
    <arg name="tracking_target_goal_topic" default="/tracking/target_goal"/>
    <arg name="enable_esdf" default="true"/>
    <arg name="sensor_topics_absolute" default="false"/>
    <arg name="sfc_path_timeout" default="0.2"/>
    <arg name="sfc_progress" default="0.75"/>
    <arg name="sfc_range" default="0.8"/>
    <arg name="jps_jump_max_cells" default="6"/>
    <arg name="jps_near_obs_radius" default="1"/>
    <arg name="drone_id"/>
    <arg name="launch_prefix" default=""/>
    <!-- main node -->
    <!-- <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="valgrind"> -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="$(arg launch_prefix)">
        <remap if="$(arg sensor_topics_absolute)" from="~odom_world" to="$(arg odometry_topic)"/>
        <remap unless="$(arg sensor_topics_absolute)" from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to = "/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
        <remap from="~planning/broadcast_traj_send" to = "/broadcast_traj_from_planner"/>
        <remap from="~planning/broadcast_traj_recv" to = "/broadcast_traj_to_planner"/>
        <remap from="~planning/heartbeat" to = "/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <remap from="/goal" to = "/goal_with_id"/>
        <remap if="$(arg sensor_topics_absolute)" from="~grid_map/odom" to="$(arg odometry_topic)"/>
        <remap unless="$(arg sensor_topics_absolute)" from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap if="$(arg sensor_topics_absolute)" from="~grid_map/cloud" to="$(arg cloud_topic)"/>
        <remap unless="$(arg sensor_topics_absolute)" from="~grid_map/cloud" to="/drone_$(arg drone_id)_$(arg cloud_topic)"/>
        <remap if="$(arg sensor_topics_absolute)" from="~grid_map/pose" to="$(arg camera_pose_topic)"/>
        <remap unless="$(arg sensor_topics_absolute)" from="~grid_map/pose" to="/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>
        <remap if="$(arg sensor_topics_absolute)" from="~grid_map/depth" to="$(arg depth_topic)"/>
        <remap unless="$(arg sensor_topics_absolute)" from="~grid_map/depth" to="/drone_$(arg drone_id)_$(arg depth_topic)"/>
        <!-- planning fsm -->
        <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
        <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
        <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <!--always set to 1.5 times grater than sensing horizen-->
        <param name="fsm/emergency_time" value="1.0" type="double"/>
        <param name="fsm/min_replan_interval" value="0.15" type="double"/>
        <param name="fsm/safety_replan_min_interval" value="0.20" type="double"/>
        <param name="fsm/safety_replan_emergency_bypass_time" value="0.10" type="double"/>
        <param name="fsm/esdf_runtime_collision_hysteresis" value="0.03" type="double"/>
        <param name="fsm/esdf_runtime_unsafe_consecutive_samples" value="2" type="int"/>
        <param name="fsm/realworld_experiment" value="false"/>
        <param name="fsm/fail_safe" value="true"/>
        <param name="fsm/state2state_keep_current_traj" value="true" type="bool"/>
        <param name="fsm/state2state_successor_enable" value="true" type="bool"/>
        <param name="fsm/state2state_keep_lookahead" value="0.80" type="double"/>
        <param name="fsm/state2state_min_rest_time" value="0.80" type="double"/>
        <param name="fsm/state2state_replan_target_shift_thresh" value="0.60" type="double"/>
        <param name="fsm/state2state_successor_lead_time" value="0.80" type="double"/>
        <param name="fsm/state2state_successor_min_progress" value="0.55" type="double"/>
        <param name="fsm/state2state_successor_target_shift_thresh" value="0.35" type="double"/>
        <param name="fsm/state2state_successor_horizon_ratio" value="0.65" type="double"/>
        <param name="fsm/state2state_successor_near_goal_hold_radius" value="0.50" type="double"/>
        <param name="fsm/state2state_space_model_preference" value="auto" type="str"/>
        <param name="fsm/use_tracking_task" value="$(arg use_tracking_task)" type="bool"/>
        <param name="fsm/tracking_reference_topic" value="$(arg tracking_reference_topic)" type="str"/>
        <param name="fsm/tracking_reference_dt" value="0.2" type="double"/>
        <param name="fsm/tracking_relay_goal" value="$(arg tracking_relay_goal)" type="bool"/>
        <param name="fsm/tracking_target_goal_topic" value="$(arg tracking_target_goal_topic)" type="str"/>
        <param name="fsm/tracking_wait_distance_buffer" value="0.35" type="double"/>
        <param name="fsm/tracking_wait_height_buffer" value="0.20" type="double"/>
        <param name="fsm/tracking_wait_target_vel_thresh" value="0.20" type="double"/>
        <param name="fsm/tracking_wait_ego_vel_thresh" value="0.15" type="double"/>
        <param name="fsm/tracking_resume_target_vel_thresh" value="0.25" type="double"/>
        <param name="fsm/tracking_resume_target_move_thresh" value="0.35" type="double"/>
        <param name="fsm/tracking_replan_target_shift_thresh" value="0.80" type="double"/>
        <param name="fsm/tracking_replan_current_traj_lookahead" value="0.80" type="double"/>
        <param name="fsm/tracking_replan_min_rest_time" value="0.80" type="double"/>
        <param name="fsm/tracking_replan_distance_buffer" value="0.55" type="double"/>
        <param name="fsm/tracking_replan_height_buffer" value="0.30" type="double"/>
        <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
        <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
        <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
        <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
        <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
        <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
        <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
        <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
        <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
        <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
        <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
        <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
        <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
        <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
        <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
        <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>
        <param name="grid_map/resolution" value="0.1" />
        <param name="grid_map/freeze_odom_after_depth" value="false" />
        <param name="grid_map/apply_cam_extrinsic_on_odom" value="true" />
        <param name="grid_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="grid_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="grid_map/map_size_z" value="$(arg map_size_z_)" />
        <param name="grid_map/local_update_range_x" value="5.5" />
        <param name="grid_map/local_update_range_y" value="5.5" />
        <param name="grid_map/local_update_range_z" value="2.0" /> <!-- different meaning between grid_map.cpp and grid_map_bigmap.cpp -->
        <param name="grid_map/obstacles_inflation" value="0.1" />
        <param name="grid_map/local_map_margin" value="10"/>
        <param name="grid_map/enable_virtual_wall" value="true"/>
        <param name="grid_map/virtual_ceil" value="3.0"/>
        <param name="grid_map/virtual_ground" value="-0.1"/>
        <param name="grid_map/ground_height" value="-0.01"/>
        <!-- camera parameter -->
        <param name="grid_map/cx" value="$(arg cx)"/>
        <param name="grid_map/cy" value="$(arg cy)"/>
        <param name="grid_map/fx" value="$(arg fx)"/>
        <param name="grid_map/fy" value="$(arg fy)"/>
        <!-- depth filter -->
        <param name="grid_map/use_depth_filter" value="true"/>
        <param name="grid_map/depth_filter_tolerance" value="0.15"/>
        <param name="grid_map/depth_filter_maxdist" value="5.0"/>
        <param name="grid_map/depth_filter_mindist" value="0.2"/>
        <param name="grid_map/depth_filter_margin" value="2"/>
        <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="grid_map/p_hit" value="0.65"/>
        <param name="grid_map/p_miss" value="0.35"/>
        <param name="grid_map/p_min" value="0.12"/>
        <param name="grid_map/p_max" value="0.90"/>
        <param name="grid_map/p_occ" value="0.80"/>
        <param name="grid_map/fading_time" value="1000.0"/>
        <param name="grid_map/min_ray_length" value="0.1"/>
        <param name="grid_map/max_ray_length" value="4.5"/>
        <param name="grid_map/visualization_truncate_height" value="1.9"/>
        <param name="grid_map/show_occ_time" value="false"/>
        <param name="grid_map/enable_esdf" value="$(arg enable_esdf)"/>
        <param name="grid_map/esdf_slice_follow_odom" value="false"/>
        <param name="grid_map/esdf_slice_z_offset" value="0.0"/>
        <param name="grid_map/pose_type" value="1"/>
        <param name="grid_map/frame_id" value="world"/>
        <!-- planner manager -->
        <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="manager/polyTraj_piece_length" value="1.5" type="double"/>
        <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
        <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <param name="manager/use_multitopology_trajs" value="$(arg use_multitopology_trajs)" type="bool"/>
        <param name="manager/use_sfc_corridor" value="$(arg use_sfc_corridor)" type="bool"/>
        <param name="manager/use_esdf" value="$(arg use_esdf)" type="bool"/>
        <param name="manager/sfc_path_timeout" value="$(arg sfc_path_timeout)" type="double"/>
        <param name="manager/sfc_progress" value="$(arg sfc_progress)" type="double"/>
        <param name="manager/sfc_range" value="$(arg sfc_range)" type="double"/>
        <param name="manager/jps_jump_max_cells" value="$(arg jps_jump_max_cells)" type="int"/>
        <param name="manager/jps_near_obs_radius" value="$(arg jps_near_obs_radius)" type="int"/>
        <param name="manager/tracking_anchor_future_time" value="1.00" type="double"/>
        <param name="manager/tracking_anchor_max_future_time" value="2.00" type="double"/>
        <param name="manager/tracking_anchor_dir_hysteresis" value="0.35" type="double"/>
        <param name="manager/tracking_anchor_side_angle_deg" value="35.0" type="double"/>
        <param name="manager/tracking_viewpoint_dt" value="0.60" type="double"/>
        <param name="manager/tracking_viewpoint_max_num" value="5" type="int"/>
        <param name="manager/tracking_viewpoint_yaw_step_deg" value="20.0" type="double"/>
        <param name="manager/tracking_viewpoint_connect_dist" value="1.5" type="double"/>
        <param name="manager/tracking_viewpoint_clearance" value="0.15" type="double"/>
        <param name="manager/drone_id" value="$(arg drone_id)"/>
        <!-- trajectory optimization -->
        <param name="optimization/constraint_points_perPiece" value="5" type="int"/>
        <param name="optimization/weight_obstacle" value="10000.0" type="double"/>
        <param name="optimization/weight_obstacle_soft" value="5000.0" type="double"/>
        <param name="optimization/weight_distance_field" value="10000.0" type="double"/>
        <param name="optimization/weight_tracking_near" value="220.0" type="double"/>
        <param name="optimization/weight_tracking_far" value="60.0" type="double"/>
        <param name="optimization/weight_tracking_vertical" value="80.0" type="double"/>
        <param name="optimization/weight_tracking_view_xy" value="40.0" type="double"/>
        <param name="optimization/weight_tracking_view_z" value="20.0" type="double"/>
        <param name="optimization/weight_tracking_terminal_pos" value="0.0" type="double"/>
        <param name="optimization/weight_tracking_terminal_vel" value="0.0" type="double"/>
        <param name="optimization/tracking_distance_min" value="1.5" type="double"/>
        <param name="optimization/tracking_distance_max" value="4.0" type="double"/>
        <param name="optimization/tracking_height_tolerance" value="0.4" type="double"/>
        <param name="optimization/tracking_smooth_eps" value="0.1" type="double"/>
        <param name="optimization/weight_swarm" value="10000.0" type="double"/>
        <param name="optimization/weight_feasibility" value="10000.0" type="double"/>
        <param name="optimization/weight_sqrvariance" value="10000.0" type="double"/>
        <param name="optimization/weight_time" value="10.0" type="double"/>
        <param name="optimization/obstacle_clearance" value="0.1" type="double"/>
        <param name="optimization/obstacle_clearance_soft" value="0.5" type="double"/>
        <param name="optimization/safety_margin" value="0.3" type="double"/>
        <param name="optimization/swarm_clearance" value="0.15000000000000002" type="double"/> <!-- heterogeneous support: my required clearance -->
        <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="optimization/max_jer" value="$(arg max_jer)" type="double"/>
        <param name="optimization/record_opt" value="true"/>
    </node>
</launch>
