        <param name="fsm/perching_auto_start" value="$(arg perching_auto_start)" type="bool"/>
        <param name="fsm/perching_robot_l" value="$(arg perching_robot_l)" type="double"/>
        <param name="fsm/perching_v_plus" value="$(arg perching_v_plus)" type="double"/>
