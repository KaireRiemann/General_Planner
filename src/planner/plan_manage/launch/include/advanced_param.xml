        <remap unless="$(arg sensor_topics_absolute)" from="~grid_map/cloud" to="/drone_$(arg drone_id)_$(arg cloud_topic)"/>
        <remap if="$(eval arg('use_cloud_input_only') != 'true' and arg('sensor_topics_absolute') == 'true')" from="~grid_map/pose" to="$(arg camera_pose_topic)"/>
        <remap if="$(eval arg('use_cloud_input_only') != 'true' and arg('sensor_topics_absolute') != 'true')" from="~grid_map/pose" to="/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>
        <remap if="$(eval arg('use_cloud_input_only') != 'true' and arg('sensor_topics_absolute') == 'true')" from="~grid_map/depth" to="$(arg depth_topic)"/>
        <remap if="$(eval arg('use_cloud_input_only') != 'true' and arg('sensor_topics_absolute') != 'true')" from="~grid_map/depth" to="/drone_$(arg drone_id)_$(arg depth_topic)"/>
        <!-- planning fsm -->
