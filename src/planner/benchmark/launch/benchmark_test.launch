<launch>
	<arg name="map_size_x" default="20.0" />
	<arg name="map_size_y" default="20.0" />
	<arg name="map_size_z" default="5.0" />
	<arg name="odom_topic" default="/uav/odom" />
	<arg name="goal_topic" default="/benchmark/goal" />

	<node pkg="benchmark" type="benchmark_node" name="benchmark_node" output="screen">
		<param name="map_size_x" value="$(arg map_size_x)" />
		<param name="map_size_y" value="$(arg map_size_y)" />
		<param name="map_size_z" value="$(arg map_size_z)" />
		<param name="odom_topic" value="$(arg odom_topic)" />
		<param name="goal_topic" value="$(arg goal_topic)" />

		<remap from="/odom" to="$(arg odom_topic)" />
		<remap from="/goal" to="$(arg goal_topic)" />
	</node>
</launch>
